# Swiggy Builders Club OAuth client id.
# Get this after applying for access at https://mcp.swiggy.com/builders/access/
SWIGGY_CLIENT_ID=

# Optional. Defaults to <app-origin>/api/auth/swiggy/callback.
# Local development redirect URI can be http://localhost:3000/api/auth/swiggy/callback
SWIGGY_REDIRECT_URI=
